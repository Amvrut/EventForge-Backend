# ==============================================================================
# EVENTFORGE SECURE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. NEVER commit your actual .env file or push RAZORPAY_KEY_SECRET to git.
# 3. RAZORPAY_KEY_SECRET must ONLY live on the server. Never send it to the frontend.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS whitelist, comma-separated if multiple)
# For local development: http://localhost:3000,http://localhost:5173
# For Vercel production: https://your-eventforge-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Razorpay API Credentials (Leave empty or commented out to enable Simulation Mode)
# For real test mode: Add your test keys (starts with rzp_test_)
# For production: Add your live keys (starts with rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Currency Configuration (Default: INR for standard Razorpay checkout)
PAYMENT_CURRENCY=INR

# Database Storage Path (File-backed SQLite storage)
# For Local Development: ./data/eventforge.db
# For Render Production (with Persistent Disk mounted at /var/data): /var/data/eventforge.db
DATABASE_FILE=./data/eventforge.db
